# Copy this file to .env in the same directory and set a real password
# before running `docker compose up`. .env is gitignored — never commit
# the real one.

POSTGRES_USER=console
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=console

# Shared secret for the read-only operator dashboard at /admin — one
# key, not a real user system. Generate with: openssl rand -base64 24
ADMIN_API_KEY=change-me-to-a-real-key

# QuickBooks Online OAuth2 app credentials (developer.intuit.com — one
# app registered for the whole platform, shared across every tenant who
# connects a QBO company; NOT a per-tenant secret). Leave unset and the
# QBO endpoints fail closed with a clear error instead of pretending to
# work. QBO_ENVIRONMENT is 'sandbox' or 'production'.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://console.qumaxa.com/v1/qbo/oauth/callback
QBO_ENVIRONMENT=sandbox

# Stripe subscription billing — qumaxa's existing Stripe account (same
# one used by the ocrdocflow project). Use TEST MODE keys (sk_test_...)
# while developing. STRIPE_PRICE_ID is the one flat monthly Price,
# created once in the Stripe Dashboard. STRIPE_WEBHOOK_SECRET comes from
# the webhook endpoint you register in the Dashboard (or `stripe listen`
# for local testing) pointed at POST /v1/billing/webhook. Leave unset
# and the billing endpoints fail closed with a clear error instead of
# pretending to work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
